def calculate_payment(quantity, rate):
    return quantity * rate

farmer_name = input("Enter farmer name: ")
quantity = float(input("Enter milk quantity in litres: "))
fat = float(input("Enter fat percentage: "))
snf = float(input("Enter SNF percentage: "))
rate = float(input("Enter rate per litre: "))

if quantity < 0 or rate < 0 or not (0 <= fat <= 100) or not (0 <= snf <= 100):
    print("Invalid input")
else:
    payment = calculate_payment(quantity, rate)

    print("\n--- Milk Payment Details ---")
    print("Farmer Name:", farmer_name)
    print("Milk Quantity:", quantity, "litres")
    print("Fat Percentage:", fat, "%")
    print("SNF Percentage:", snf, "%")
    print("Total Payment: Rs.", round(payment, 2))
